{
  "name": "service-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API e Socket.IO do sistema genérico de gestão de serviços.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "check": "node --check server/config.js && node --check server/server.js && node --check server/store.js && node --check server/reports.js",
    "migrate:supabase:dry-run": "node scripts/migrate-to-supabase.js --mode=dry-run",
    "migrate:supabase:inspect": "node scripts/migrate-to-supabase.js --mode=inspect",
    "migrate:supabase:apply": "node scripts/migrate-to-supabase.js --mode=apply",
    "migration:check": "node scripts/check-relational-migration.js",
    "backup:postgres": "node scripts/backup-postgres.js",
    "migration:dry-run": "node scripts/relational-migration/migrate.js --mode=dry-run",
    "migration:apply": "node scripts/relational-migration/migrate.js --mode=apply",
    "migration:verify": "node scripts/relational-migration/migrate.js --mode=verify",
    "test": "node --test tests/*.test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload service-manager"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "socket.io": "^4.7.5",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0"
  }
}
