NODE_ENV=production
TZ=America/Sao_Paulo

APP_NAME=EG Automacoes Services
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true

# URL publica da API no Render. Preencha depois que o Render gerar a URL.
PUBLIC_URL=https://eg-services-api.onrender.com

# URL publica do frontend na Vercel.
FRONTEND_URL=https://services.egautomacoes.com.br

HTTP_LOG_FORMAT=combined
JSON_LIMIT=10mb
AUTH_TOKEN_TTL_HOURS=24

# Local/teste: use DB_CLIENT=json para gravar em backend/data/db.json.
# Producao vendavel com Neon: use DB_CLIENT=postgres e cole a connection string do Neon.
DB_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_SSL=true
DB_STORAGE_TABLE=eg_services_store
DATA_DIR=./data
DATA_FILE=db.json

# Inclua a URL da Vercel e a URL da API. ALLOW_LOCAL_ORIGINS pode ficar false em producao.
CORS_ORIGINS=https://services.egautomacoes.com.br,https://eg-services-api.onrender.com,capacitor://localhost,http://localhost,https://localhost,http://127.0.0.1
ALLOW_LOCAL_ORIGINS=false
