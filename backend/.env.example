NODE_ENV=production
TZ=America/Sao_Paulo

APP_NAME=Order Service
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true

# URL publica da API no Render. Preencha depois que o Render gerar a URL.
PUBLIC_URL=https://sua-api.exemplo.com

# URL pública do frontend publicado.
FRONTEND_URL=https://seu-dominio.exemplo.com

HTTP_LOG_FORMAT=combined
JSON_LIMIT=10mb
AUTH_TOKEN_TTL_HOURS=24

# Apenas para apresentação local. Nunca ative em produção.
DEMO_MODE=false

# Use temporariamente apenas para resetar admin sem acesso ao shell.
# Depois do reset, remova esta variavel do Render.
ADMIN_RESET_TOKEN=

# Local/teste: use DB_CLIENT=json para gravar em backend/data/db.json.
# Instalação vendável com PostgreSQL: use DB_CLIENT=postgres e informe a connection string do banco escolhido.
DB_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
DATABASE_SSL=true
DB_STORAGE_TABLE=service_manager_store
DATA_DIR=./data
DATA_FILE=db.json

# Migração relacional: mantenha legacy até o corte explicitamente aprovado.
DATA_REPOSITORY=legacy
MIGRATION_ALLOW_WRITES=false

# Object Storage privado S3-compatible (Cloudflare R2, Amazon S3 ou equivalente).
# Mantenha desativado até criar e validar o bucket de homologação.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=order-service-private
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_MAX_BYTES=3145728
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Inclua as URLs públicas autorizadas. ALLOW_LOCAL_ORIGINS pode ficar false em producao.
CORS_ORIGINS=https://seu-dominio.exemplo.com,https://sua-api.exemplo.com,capacitor://localhost,http://localhost,https://localhost,http://127.0.0.1
ALLOW_LOCAL_ORIGINS=false
